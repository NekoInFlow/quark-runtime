{
  "id": "read_text",
  "title": "Прочитать файл",
  "description": "Показывает начало текстового файла",
  "when": "пользователь просит прочитать или показать содержимое файла",
  "risk": "low",
  "args": {
    "path": { "type": "string", "description": "имя или путь к файлу" }
  },
  "match": [
    "^(?:прочитай|прочти|прочитать)\\s+(?:файл\\s+)?(?P<path>.+?)\\s*[.!?]*$",
    "^что\\s+в\\s+(?:файле\\s+)?(?P<path>\\S+)\\s*[.!?]*$"
  ],
  "run": { "type": "read_text" }
}
