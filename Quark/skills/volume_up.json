{
  "id": "volume_up",
  "title": "Сделать громче",
  "description": "Увеличивает громкость звука на шаг",
  "when": "пользователь просит прибавить звук или сделать громче",
  "risk": "low",
  "match": [
    "^(?:сделай\\s+)?(?:громче|погромче|прибавь\\s+(?:звук|громкость|громкости)|увеличь\\s+(?:звук|громкость|громкости))\\s*[.!?]*$"
  ],
  "run": { "type": "system", "action": "volume_up" }
}
