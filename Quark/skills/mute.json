{
  "id": "mute",
  "title": "Выключить звук",
  "description": "Переключает звук: выключить или вернуть",
  "when": "пользователь просит выключить или включить звук",
  "risk": "low",
  "match": [
    "^(?:выключи|отключи|включи|верни)\\s+(?:звук|audio)\\s*[.!?]*$",
    "^(?:звук\\s+(?:выключи|включи))\\s*[.!?]*$"
  ],
  "run": { "type": "system", "action": "mute" }
}
