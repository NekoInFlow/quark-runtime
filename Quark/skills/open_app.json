{
  "id": "open_app",
  "title": "Открыть программу",
  "description": "Запускает программу из белого списка",
  "when": "пользователь просит открыть, запустить или включить программу",
  "risk": "low",
  "args": {
    "app": { "type": "string", "description": "название программы: блокнот, калькулятор, проводник" }
  },
  "match": [
    "^(?:открой|открыть|запусти|запустить|включи|вруби)\\s+(?:программу\\s+|приложение\\s+)?(?P<app>[\\p{L}\\p{N} ._-]+?)\\s*[.!?]*$"
  ],
  "run": { "type": "run_program" }
}
